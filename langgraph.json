{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
  "graphs": {
    "direct": "llm4om.server.graphs:direct",
    "or_llm_agent": "llm4om.server.graphs:or_llm_agent",
    "llmopt": "llm4om.server.graphs:llmopt",
    "trival": "llm4om.server.graphs:trival",
    "bind": "llm4om.server.graphs:bind",
    "autoco": "llm4om.server.graphs:autoco",
    "optitree": "llm4om.server.graphs:optitree",
    "coe": "llm4om.server.graphs:coe",
    "optimus": "llm4om.server.graphs:optimus",
    "requirements": "llm4om.server.graphs:requirements",
    "solution_chat": "llm4om.server.graphs:solution_chat",
    "optimization": "llm4om.server.graphs:optimization"
  },
  "http": {
    "app": "llm4om.server.app:app",
    "cors": {
      "allow_origins": [
        "https://smith.langchain.com"
      ],
      "allow_methods": [
        "*"
      ],
      "allow_headers": [
        "*"
      ],
      "expose_headers": [
        "x-pagination-total",
        "x-pagination-next",
        "content-location"
      ]
    }
  },
  "env": ".env"
}
