# The server's own LLM preset (id "env"), listed first and used by default. Visitors can use it but cannot
# read its key, change it or delete it; edit or remove these lines on the server instead.
# Provider: openai, google, kimi, glm, openrouter, bailian, deepseek, anthropic or openai_compatible.
LLM4OM_LLM_PROVIDER=openai_compatible
LLM4OM_LLM_BASE_URL=https://api.example.com/v1
LLM4OM_LLM_MODEL=your-model-id
LLM4OM_LLM_API_KEY=
# Optional JSON merged into each request body, e.g. {"thinking": {"type": "disabled"}} for DeepSeek.
LLM4OM_LLM_EXTRA_BODY=

# Docker deployment (compose.yaml) only: the published port, and the Docker socket for rootless Docker.
# LLM4OM_PORT=8767
# DOCKER_SOCKET=/var/run/docker.sock
