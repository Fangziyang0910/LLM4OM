# The server's own LLM preset (id "env"), listed first and used by default. Visitors can use it but cannot
# read its key, change it or delete it; edit or remove these lines on the server instead.
# Provider: openai, google, kimi, glm, openrouter, bailian, deepseek, anthropic or openai_compatible.
LLM4OM_LLM_PROVIDER=openai_compatible
LLM4OM_LLM_BASE_URL=https://api.example.com/v1
LLM4OM_LLM_MODEL=your-model-id
LLM4OM_LLM_API_KEY=
# Optional JSON merged into each request body, e.g. {"thinking": {"type": "disabled"}} for DeepSeek.
LLM4OM_LLM_EXTRA_BODY=

# Docker deployment (compose.yaml) only: the published port, and the Docker socket for rootless Docker.
# LLM4OM_PORT=8767
# DOCKER_SOCKET=/var/run/docker.sock

# Shared deployments, optional; 0 or unset means no limit.
# LLM4OM_DAILY_TOKENS=2000000      # tokens (input + output) each LLM preset may use per day
# TZ=Asia/Shanghai                # the day above starts at midnight here; containers use UTC otherwise
# LLM4OM_RUNS_PER_HOUR=30          # runs each client address may start per hour
# LLM4OM_SANDBOX_JOBS=4            # total simultaneous solves/check scripts in this service, across all runs
# LLM4OM_TRUST_PROXY=1             # behind a reverse proxy: count the client from X-Forwarded-For

# HTTPS with the compose `https` profile (Caddy): the domain, and the app published on this machine only.
# LLM4OM_DOMAIN=llm4om.example.edu
# LLM4OM_PORT=127.0.0.1:8767

# LangSmith tracing, optional: problems, data and replies are sent to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=llm4om
